                <div class="p-4 rounded-2xl bg-orange-950/30 border border-orange-500/40 flex items-center gap-3">
                    <input type="checkbox" id="check-poem-5" onchange="togglePoemStep(5)" class="w-6 h-6 rounded accent-orange-500 cursor-pointer">
                    <label for="check-poem-5" class="font-bold text-orange-200 text-sm cursor-pointer select-none">
                        Je respecte les silences de la ponctuation et je mets de la vie et des émotions dans ma voix !
                    </label>
                </div>
            </div>
        </section>

        <!-- =================== ÉTAPE 6 : LE TEST FINAL DE RÉCITATION =================== -->
        <section id="stage-6" class="hidden fade-in space-y-6">
            <div class="flex items-center justify-between">
                <button onclick="showSection('stage-5')" class="px-4 py-2 rounded-xl bg-cosmos-900/90 border border-slate-700 text-slate-300 hover:text-white hover:bg-cosmos-800 text-xs sm:text-sm font-bold flex items-center gap-2 transition-all">
                    <i class="fa-solid fa-arrow-left"></i> Étape 5 : Le Ton
                </button>
                <button onclick="showSection('landing-dashboard')" class="px-4 py-2 rounded-xl bg-star-pink hover:bg-pink-400 text-white font-bold text-xs sm:text-sm flex items-center gap-2 transition-all shadow-md">
                    Voir Mon Bilan Cosmique <i class="fa-solid fa-trophy"></i>
                </button>
            </div>

            <div class="rounded-3xl border border-star-pink/40 bg-cosmos-900/90 backdrop-blur-xl p-6 sm:p-8 shadow-glow space-y-6">
                <div class="flex items-center gap-4 border-b border-star-pink/20 pb-5">
                    <div class="w-16 h-16 rounded-2xl bg-pink-500/20 border border-pink-500/40 flex items-center justify-center text-3xl">
                        🏆
                    </div>
                    <div>
                        <span class="text-xs font-black uppercase tracking-wider text-pink-400 bg-pink-950/70 border border-pink-500/30 px-3 py-1 rounded-full">
                            Étape 6 sur 6
                        </span>
                        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">
                            L'Épreuve du Miroir & de l'Enregistreur
                        </h2>
                    </div>
                </div>

                <div class="space-y-4">
                    <p class="text-xs sm:text-sm text-slate-300">
                        C'est la répétition générale avant le grand jour ! Voici les 3 épreuves pour être totalement imbattable :
                    </p>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="p-4 rounded-2xl bg-cosmos-950/60 border border-pink-500/30 space-y-2">
                            <div class="text-3xl">🧸</div>
                            <h4 class="font-bold text-pink-300 text-sm">Le Public d'Entraînement</h4>
                            <p class="text-xs text-slate-300 leading-relaxed">
                                Installe ton doudou préféré, ton chien ou un membre de ta famille sur une chaise. Récite-lui le texte d'un bout à l'autre sans t'arrêter même si tu hésites !
                            </p>
                        </div>

                        <div class="p-4 rounded-2xl bg-cosmos-950/60 border border-pink-500/30 space-y-2">
                            <div class="text-3xl">🪞</div>
                            <h4 class="font-bold text-pink-300 text-sm">Le Test du Miroir</h4>
                            <p class="text-xs text-slate-300 leading-relaxed">
                                Regarde-toi réciter dans le miroir. Observe ton visage : tes sourcils bougent-ils ? As-tu l'air détendu et confiant ?
                            </p>
                        </div>

                        <div class="p-4 rounded-2xl bg-cosmos-950/60 border border-pink-500/30 space-y-2">
                            <div class="text-3xl">📱</div>
                            <h4 class="font-bold text-pink-300 text-sm">L'Enregistrement Dictaphone</h4>
                            <p class="text-xs text-slate-300 leading-relaxed">
                                Avec le téléphone d'un parent ou une tablette, enregistre ta voix puis réécoute-toi en suivant le texte avec ton doigt : as-tu oublié un petit mot (« de », « le », « et ») ?
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Case de validation finale -->
                <div class="p-4 rounded-2xl bg-pink-950/30 border border-star-pink/40 flex items-center gap-3">
                    <input type="checkbox" id="check-poem-6" onchange="togglePoemStep(6)" class="w-6 h-6 rounded accent-pink-500 cursor-pointer">
                    <label for="check-poem-6" class="font-bold text-pink-200 text-sm cursor-pointer select-none">
                        J'ai réussi à réciter la poésie entière sans regarder le cahier : je suis 100% prêt !
                    </label>
                </div>
            </div>
        </section>

    </main>

    <!-- PIED DE PAGE COSMIQUE -->
    <footer class="border-t border-purple-900/50 bg-cosmos-950/90 py-5 px-4 text-center text-xs text-slate-400">
        <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
            <span class="flex items-center gap-2">
                <i class="fa-solid fa-feather-pointed text-star-cyan"></i>
                Méthode de récitation et de mémorisation poétique • Cycle 3 / CM1
            </span>
            <span>Apprendre avec joie et confiance en soi ✨</span>
        </div>
    </footer>

    <!-- SCRIPT DE NAVIGATION, PROGRESSION & THÈME -->
    <script>
        // État des 6 balises d'apprentissage
        const stepsStatus = {
            1: false,
            2: false,
            3: false,
            4: false,
            5: false,
            6: false
        };

        const ranksList = [
            "Apprenti Poète",
            "Éclaireur de Rimes",
            "Magicien des Vers",
            "Conteur d'Étoiles",
            "Orateur Stellaire",
            "Virtuose de la Scène",
            "Grand Maître Poète 👑"
        ];

        // Changement de vue (SPA)
        function showSection(sectionId) {
            const sections = [
                'landing-dashboard',
                'stage-1',
                'stage-2',
                'stage-3',
                'stage-4',
                'stage-5',
                'stage-6'
            ];

            sections.forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el.classList.add('hidden');
                    el.classList.remove('fade-in');
                }
            });

            const target = document.getElementById(sectionId);
            if (target) {
                target.classList.remove('hidden');
                void target.offsetWidth; // Déclenchement du reflow pour rejouer l'animation
                target.classList.add('fade-in');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        // Coche et mise à jour
        function togglePoemStep(index) {
            const checkbox = document.getElementById('check-poem-' + index);
            stepsStatus[index] = checkbox.checked;

            const starTag = document.getElementById('star-tag-' + index);
            if (starTag) {
                if (checkbox.checked) {
                    starTag.classList.remove('hidden');
                } else {
                    starTag.classList.add('hidden');
                }
            }

            refreshGauge();
        }

        // Actualisation jauge et rang
        function refreshGauge() {
            const total = 6;
            const doneCount = Object.values(stepsStatus).filter(Boolean).length;
            const ratio = Math.round((doneCount / total) * 100);

            // Jauge graphique
            const fill = document.getElementById('gauge-fill');
            const txt = document.getElementById('gauge-text');
            fill.style.width = ratio + '%';
            txt.innerText = doneCount + '/' + total;

            // Titre de rang
            const rankLabel = document.getElementById('rank-indicator');
            rankLabel.innerText = ranksList[doneCount];

            // Célébration si 6/6
            const banner = document.getElementById('victory-banner');
            if (doneCount === total) {
                banner.classList.remove('hidden');
                launchCosmicCelebration();
            } else {
                banner.classList.add('hidden');
            }
        }

        // Remise à zéro
        function resetPoemChecklist() {
            for (let i = 1; i <= 6; i++) {
                stepsStatus[i] = false;
                const chk = document.getElementById('check-poem-' + i);
                if (chk) chk.checked = false;
                const tag = document.getElementById('star-tag-' + i);
                if (tag) tag.classList.add('hidden');
            }
            refreshGauge();
        }

        // Étoiles filantes & confettis
        function launchCosmicCelebration() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 120,
                    spread: 85,
                    origin: { y: 0.6 },
                    colors: ['#00f5d4', '#ffbe0b', '#ff006e', '#8338ec', '#3a86ff']
                });

                setTimeout(() => {
                    confetti({
                        particleCount: 70,
                        angle: 60,
                        spread: 60,
                        origin: { x: 0 }
                    });
                    confetti({
                        particleCount: 70,
                        angle: 120,
                        spread: 60,
                        origin: { x: 1 }
                    });
                }, 300);
            }
        }

        // Bascule Jour / Nuit
        let isCosmicDark = true;
        function toggleDayNight() {
            const body = document.getElementById('page-body');
            const html = document.documentElement;
            const icon = document.getElementById('theme-btn-icon');

            isCosmicDark = !isCosmicDark;

            if (isCosmicDark) {
                html.classList.add('dark');
                body.classList.remove('day-canvas', 'text-slate-900');
                body.classList.add('stars-canvas', 'text-slate-100');
                icon.className = "fa-solid fa-moon text-lg";
            } else {
                html.classList.remove('dark');
                body.classList.remove('stars-canvas', 'text-slate-100');
                body.classList.add('day-canvas', 'text-slate-900');
                icon.className = "fa-solid fa-sun text-lg text-amber-500";
            }
        }
    </script>
</body>
</html>
